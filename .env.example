# GEMINI_API_KEY: Optional - for intelligent AI explanations or study assist
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret for signing session JWTs
JWT_SECRET="campus-os-secure-jwt-secret-key-production-ready"

# Database Configuration (Defaults to persistent storage)
DATABASE_URL="postgresql://campus:campus@localhost:5432/campus_os"
DATABASE_FILE="./data/campus_os.json"

# Server Port
PORT=3000

# Google OAuth 2.0 Settings
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"
